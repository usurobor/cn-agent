{
  "version": "cnos.cellspec.v0",
  "contract": {
    "id": "cds-code",
    "goal": "Carry out the change described by the issue in the repository at base_sha",
    "required_evidence": [
      { "id": "diff", "kind": "diff", "producer": "alpha" }
    ]
  },
  "protocol_id": "cnos.cdd.cds.receipt.v1",
  "profile": "code",
  "params": {
    "language": { "kind": "skill", "required": true, "domain": ["go", "ocaml", "rust", "python", "typescript"] },
    "style": { "kind": "skill", "required": false, "default": "functional" },
    "provider": { "kind": "value", "required": true, "domain": ["claude", "fake"] },
    "base_sha": { "kind": "value", "required": true },
    "repo": { "kind": "value", "required": false, "default": "." }
  },
  "alpha": { "skills": ["eng", "$language", "$style"] },
  "beta": { "skills": ["$language", "cds-review"] }
}

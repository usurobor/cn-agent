{
  "version": "cnos.cellspec.v0",
  "contract": {
    "id": "cds-code",
    "goal": "Carry out the change described by the issue in the repository the run input's subject pins",
    "required_evidence": [
      {
        "id": "diff",
        "kind": "diff",
        "producer": "alpha"
      }
    ]
  },
  "protocol_id": "cnos.cdd.cds.receipt.v1",
  "params": {
    "language": {
      "required": true,
      "domain": [
        "cnos.eng:eng/go",
        "cnos.eng:eng/ocaml",
        "cnos.eng:eng/typescript"
      ]
    },
    "provider": {
      "required": true,
      "domain": [
        "claude-cli",
        "fake"
      ]
    },
    "model": {
      "required": false,
      "default": ""
    }
  },
  "methodology": {
    "kind": "skills.methodology.v0",
    "skills": [
      "cnos.eng:eng/code",
      "cnos.eng:eng/test",
      "$language",
      "cnos.eng:eng/write-functional"
    ]
  },
  "alpha": {
    "fill": "cds.patch",
    "cognition": {
      "provider": "$provider",
      "model": "$model"
    }
  },
  "beta": {
    "fill": "cdd.mechanical-unmet"
  }
}

{
  "version": "cnos.cellspec.v0",
  "contract": {
    "id": "cds-code-reviewed",
    "goal": "Carry out the change described by the issue in the repository at base_sha",
    "subject": {
      "kind": "git.snapshot/0.1",
      "repo": "$repo",
      "base_sha": "$base_sha"
    },
    "task": {
      "kind": "cnos.cds.issue.v0",
      "id": "cds-fixture-contributing",
      "problem": {
        "exists": "The repository carries no contribution guide, so a new contributor infers how to build and test it from the source tree.",
        "expected": "A CONTRIBUTING.md at the repository root states how to build the project, how to run its tests, and what a change must satisfy before it is proposed.",
        "diverges": "Nothing in the repository states the contribution procedure, so every contributor reconstructs one and they do not reconstruct the same one."
      },
      "sources": [
        {
          "claim": "what the repository is and how it is built",
          "path": "README.md"
        }
      ],
      "scope": {
        "in": [
          "add CONTRIBUTING.md at the repository root",
          "link CONTRIBUTING.md from README.md"
        ],
        "out": [
          "changing the build system",
          "changing any file other than README.md and CONTRIBUTING.md"
        ]
      }
    },
    "required_evidence": [
      {
        "id": "diff",
        "kind": "diff",
        "producer": "alpha"
      }
    ]
  },
  "protocol_id": "cnos.cdd.cds.receipt.v1",
  "params": {
    "language": {
      "required": true,
      "domain": [
        "cnos.eng:eng/go",
        "cnos.eng:eng/ocaml",
        "cnos.eng:eng/typescript"
      ]
    },
    "provider": {
      "required": true,
      "domain": [
        "claude-cli",
        "fake"
      ]
    },
    "model": {
      "required": false,
      "default": ""
    },
    "base_sha": {
      "required": true
    },
    "repo": {
      "required": false,
      "default": "."
    },
    "review_provider": {
      "required": false,
      "default": "fake"
    },
    "review_model": {
      "required": false,
      "default": ""
    }
  },
  "alpha": {
    "fill": "cds.patch",
    "cognition": {
      "provider": "$provider",
      "model": "$model"
    },
    "skills": [
      "cnos.eng:eng/code",
      "cnos.eng:eng/test",
      "$language",
      "cnos.eng:eng/write-functional"
    ]
  },
  "beta": {
    "fill": "cds.review",
    "cognition": {
      "provider": "$review_provider",
      "model": "$review_model"
    },
    "skills": [
      "cnos.cdd:cdd/review",
      "$language"
    ]
  }
}
